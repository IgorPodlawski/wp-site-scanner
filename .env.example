# External APIs
WPSCAN_API_TOKEN=
PAGESPEED_API_KEY=

# Identity / politeness
AUDIT_CONTACT_URL=https://example.com/about-this-scan
AUDIT_USER_AGENT=

# Logging
LOG_LEVEL=info

# Storage / cache
CACHE_DIR=./data/cache
DATABASE_PATH=./data/wp-audit.sqlite

# HTTP limits (optional overrides of config defaults)
HTTP_TIMEOUT_MS=10000
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=10485760

# Batch tuning
BATCH_CONCURRENCY=4
PER_HOST_DELAY_MS=1000
